# ==============================================================================
# PROJECT SENTINEL - DEVSECOPS & KONG GATEWAY ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# AI Security Agent LLM Configuration (OpenAI SDK / Alibaba Cloud Qwen API)
AI_AGENT_API_KEY=your_alibaba_or_openai_api_key_here
AI_AGENT_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_AGENT_MODEL=qwen-plus

# Kong Gateway API Key Secret (Injected dynamically into Kong Gateway via KONG_VAULT_ENV_AGENT_API_KEY)
KONG_VAULT_ENV_AGENT_API_KEY=your_kong_gateway_agent_api_key_here
AGENT_API_KEY=your_kong_gateway_agent_api_key_here

# Gateway Host & Port Configuration
GATEWAY_HOST=http://localhost:8000
GATEWAY_URL=http://localhost:8000
ADMIN_API_URL=http://localhost:8001

# Timeout & Protection Settings (in milliseconds)
GATEWAY_CONNECT_TIMEOUT=5000
GATEWAY_READ_TIMEOUT=5000
GATEWAY_WRITE_TIMEOUT=5000
