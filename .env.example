# ==============================================================================
# PROJECT SENTINEL - DEVSECOPS & KONG GATEWAY ENVIRONMENT CONFIGURATION
# ==============================================================================

# Kong Vault Environment Prefix (Used by Kong to resolve vault://env/<key>)
KONG_VAULT_ENV_PREFIX=KONG_VAULT_ENV_

# AI Security Agent API Key Secret (Injected dynamically into Kong Gateway)
KONG_VAULT_ENV_AGENT_API_KEY=sentinel-agent-secure-key-2026

# Gateway Host & Port Configuration
GATEWAY_URL=http://localhost:8000
ADMIN_API_URL=http://localhost:8001

# Timeout & Protection Settings (in milliseconds)
GATEWAY_CONNECT_TIMEOUT=5000
GATEWAY_READ_TIMEOUT=5000
GATEWAY_WRITE_TIMEOUT=5000
